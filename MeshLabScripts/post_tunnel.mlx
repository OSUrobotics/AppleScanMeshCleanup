<!DOCTYPE FilterScript>
<FilterScript>
 <filter name="Merge Close Vertices">
  <Param tooltip="All the vertices that closer than this threshold are merged together. Use very small values, default values is 1/10000 of bounding box diagonal. " description="Merging distance" type="RichAbsPerc" min="0" max="1.46755" value="0.014676" name="Threshold"/>
 </filter>
 <filter name="Remove Duplicate Faces"/>
 <filter name="Remove Duplicate Vertices"/>
 <filter name="Remove T-Vertices">
  <Param tooltip="Selects whether to remove t-vertices by edge collapse or edge flip." description="Method" type="RichEnum" enum_cardinality="2" enum_val0="Edge Collapse" value="0" enum_val1="Edge Flip" name="method"/>
  <Param tooltip="Detects faces where the base/height ratio is lower than this value" description="Ratio" type="RichFloat" value="40" name="Threshold"/>
  <Param tooltip="Iterates the algorithm until it reaches convergence" description="Iterate until convergence" type="RichBool" value="true" name="Repeat"/>
 </filter>
 <filter name="Remove Vertices wrt Quality">
  <Param tooltip="" description="Delete all vertices with quality under:" type="RichAbsPerc" min="0" max="0" value="0" name="MaxQualityThr"/>
 </filter>
 <filter name="Remove Isolated pieces (wrt Diameter)">
  <Param tooltip="Delete all the connected components (floating pieces) with a diameter smaller than the specified one" description="Enter max diameter of isolated pieces" type="RichAbsPerc" min="0" max="146.755" value="14.6755" name="MinComponentDiag"/>
  <Param tooltip="if true, the unreferenced vertices remaining after the face deletion are removed." description="Remove unfreferenced vertices" type="RichBool" value="true" name="removeUnref"/>
 </filter>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." description="Method" type="RichEnum" enum_cardinality="2" enum_val0="Remove Faces" value="0" enum_val1="Split Vertices" name="method"/>
 </filter>
 <filter name="Remove Unreferenced Vertices"/>
 <filter name="Remove Zero Area Faces"/>
 <filter name="Repair non Manifold Vertices by splitting">
  <Param tooltip="This parameter denote the ratio ⍺ of displacement of a vertex. When a vertex &lt;i>v&lt;/i> is split, it is moved towards the barycenter &lt;i>b&lt;/i> of the FF connected faces sharing it of a (&lt;i>v&lt;/i>-&lt;i>b&lt;/i>)*⍺. When ⍺ is zero vertex is not displaced. When ⍺ is 0.5 the new vertex is half away toward the barycenter of the face. Reasonable values are in the [0 .. 0.1] range." description="Vertex Displacement Ratio" type="RichFloat" value="0" name="VertDispRatio"/>
 </filter>
 <filter name="Close Holes">
  <Param tooltip="The size is expressed as number of edges composing the hole boundary" description="Max size to be closed " type="RichInt" value="30" name="MaxHoleSize"/>
  <Param tooltip="Only the holes with at least one of the boundary faces selected are closed" description="Close holes with selected faces" type="RichBool" value="false" name="Selected"/>
  <Param tooltip="After closing a hole the faces that have been created are left selected. Any previous selection is lost. Useful for example for smoothing the newly created holes." description="Select the newly created faces" type="RichBool" value="true" name="NewFaceSelected"/>
  <Param tooltip="When closing an holes it tries to prevent the creation of faces that intersect faces adjacent to the boundary of the hole. It is an heuristic, non intersetcting hole filling can be NP-complete." description="Prevent creation of selfIntersecting faces" type="RichBool" value="true" name="SelfIntersection"/>
  <Param tooltip="After closing the hole it will refine the newly created triangles to make the surface more smooth and the triangulation more evenly spaced" description="Refine Filled Hole" type="RichBool" value="false" name="RefineHole"/>
  <Param tooltip="The target edge lenght of the triangulation inside the filled hole." description="Hole Refinement Edge Len" type="RichAbsPerc" min="0" max="146.755" value="4.4027" name="RefineHoleEdgeLen"/>
 </filter>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." description="Method" type="RichEnum" enum_cardinality="2" enum_val0="Remove Faces" value="0" enum_val1="Split Vertices" name="method"/>
 </filter>
 <filter name="Select small disconnected component">
  <Param tooltip="This ratio (between 0 and 1) defines the meaning of &lt;i>small&lt;/i> as the threshold ratio between the number of facesof the largest component and the other ones. A larger value will select more components." description="Small component ratio" type="RichFloat" value="0.1" name="NbFaceRatio"/>
  <Param tooltip="" description="Select only non closed components" type="RichBool" value="false" name="NonClosedOnly"/>
  <Param tooltip="Number of neighbors used to estimate the local density. Larger values lead to smoother variations." description="Number of neighbors" type="RichInt" value="16" name="NbNeighbors"/>
 </filter>
 <filter name="Remove T-Vertices">
  <Param tooltip="Selects whether to remove t-vertices by edge collapse or edge flip." description="Method" type="RichEnum" enum_cardinality="2" enum_val0="Edge Collapse" value="0" enum_val1="Edge Flip" name="method"/>
  <Param tooltip="Detects faces where the base/height ratio is lower than this value" description="Ratio" type="RichFloat" value="40" name="Threshold"/>
  <Param tooltip="Iterates the algorithm until it reaches convergence" description="Iterate until convergence" type="RichBool" value="true" name="Repeat"/>
 </filter>
 <filter name="Repair non Manifold Edges">
  <Param tooltip="Selects whether to remove non manifold edges by removing faces or by splitting vertices." description="Method" type="RichEnum" enum_cardinality="2" enum_val0="Remove Faces" value="0" enum_val1="Split Vertices" name="method"/>
 </filter>
 <filter name="Close Holes">
  <Param tooltip="The size is expressed as number of edges composing the hole boundary" description="Max size to be closed " type="RichInt" value="30" name="MaxHoleSize"/>
  <Param tooltip="Only the holes with at least one of the boundary faces selected are closed" description="Close holes with selected faces" type="RichBool" value="false" name="Selected"/>
  <Param tooltip="After closing a hole the faces that have been created are left selected. Any previous selection is lost. Useful for example for smoothing the newly created holes." description="Select the newly created faces" type="RichBool" value="true" name="NewFaceSelected"/>
  <Param tooltip="When closing an holes it tries to prevent the creation of faces that intersect faces adjacent to the boundary of the hole. It is an heuristic, non intersetcting hole filling can be NP-complete." description="Prevent creation of selfIntersecting faces" type="RichBool" value="true" name="SelfIntersection"/>
  <Param tooltip="After closing the hole it will refine the newly created triangles to make the surface more smooth and the triangulation more evenly spaced" description="Refine Filled Hole" type="RichBool" value="false" name="RefineHole"/>
  <Param tooltip="The target edge lenght of the triangulation inside the filled hole." description="Hole Refinement Edge Len" type="RichAbsPerc" min="0" max="146.755" value="4.4027" name="RefineHoleEdgeLen"/>
 </filter>
</FilterScript>
